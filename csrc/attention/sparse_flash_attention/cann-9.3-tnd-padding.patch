+TEMPLATES_DEF_NO_DEFAULT __aicore__ inline void SFAVectorService<TEMPLATE_ARGS>::ClearTndOutputPadding(
+    const ConstInfo& constInfo)
+{
+    // In TND the last cumulative Q length can be shorter than the physical T.
+    // The attention loop writes only the prefix. Give each vector core whole tail rows.
+    const int64_t validRows = constInfo.bSize == 0 ? 0 : cuSeqlensQGm.GetValue(constInfo.bSize - 1);
+    const uint64_t coreCount = GetBlockNum() * CV_RATIO;
+    if (validRows < 0 || static_cast<uint64_t>(validRows) >= constInfo.s1Size || coreCount == 0) {
+        return;
+    }
+    const uint64_t tailRows = constInfo.s1Size - validRows;
+    const uint64_t rowsPerCore = (tailRows + coreCount - 1) / coreCount;
+    const uint64_t firstRow = validRows + constInfo.aivIdx * rowsPerCore;
+    if (firstRow >= constInfo.s1Size) {
+        return;
+    }
+    const uint64_t rowsLeft = constInfo.s1Size - firstRow;
+    const uint64_t rows = rowsLeft < rowsPerCore ? rowsLeft : rowsPerCore;
+    const uint64_t rowWidth = constInfo.gSize * constInfo.dSizeV;
+    auto event = GetTPipePtr()->AllocEventID<HardEvent::MTE3_V>();
+    matmul::InitOutput<OUTPUT_T>(attentionOutGm[firstRow * rowWidth], rows * rowWidth, 0);
+    SetFlag<HardEvent::MTE3_V>(event);
+    WaitFlag<HardEvent::MTE3_V>(event);
+    GetTPipePtr()->ReleaseEventID<HardEvent::MTE3_V>(event);
+}
